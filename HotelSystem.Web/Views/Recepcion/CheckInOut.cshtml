@model CheckInOutPageDto
@inject HotelSystem.Application.Abstracciones.IReloj Reloj
@{
    ViewData["Title"] = "Check-in / Check-out";
    ViewData["Nav"] = "CheckInOut";
}
<div class="p-6 space-y-6 h-full overflow-y-auto">
    <div>
        <h1 class="text-slate-100 font-semibold text-xl">Check-in / Check-out</h1>
        <p class="text-slate-500 text-sm mt-0.5">Operaciones del dia - @Ui.LongDate(Reloj.Hoy) <span class="text-slate-700">(HU-06)</span></p>
    </div>

    <div class="flex gap-1 bg-[#080f1c] p-1 rounded-xl w-fit">
        @foreach (var (tab, label, count) in new[] { ("checkin", "Check-in", Model.CheckInCount), ("checkout", "Check-out", Model.CheckOutCount) })
        {
            <a asp-action="CheckInOut" asp-route-tab="@tab"
               class="px-5 py-2 rounded-lg text-sm font-medium transition-colors @(Model.Tab == tab ? "bg-[#0e1a2e] text-slate-100" : "text-slate-600 hover:text-slate-300")">
                @label<span class="ml-2 text-xs opacity-50">@count</span>
            </a>
        }
    </div>

    <form asp-action="CheckInOut" method="get" class="relative max-w-xs">
        <input type="hidden" name="tab" value="@Model.Tab" />
        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-600">@Ui.Ic(Icons.Search, 14)</div>
        <input name="q" value="@Model.Query" placeholder="Buscar huesped o habitacion..."
               class="w-full bg-[#0e1a2e] border border-[#1a2d48] rounded-xl pl-8 pr-4 py-2.5 text-slate-200 text-sm placeholder-slate-700 focus:outline-none focus:border-amber-400/50" />
    </form>

    <div class="space-y-3 max-w-2xl">
        @foreach (var item in Model.Items)
        {
            <div class="bg-[#0e1a2e] border border-[#1a2d48] rounded-xl p-5 flex items-center justify-between gap-4">
                <div class="flex items-center gap-4 min-w-0">
                    <div class="w-12 h-12 rounded-xl bg-[#142035] flex items-center justify-center text-amber-400 font-semibold text-sm flex-shrink-0" style="@Ui.Mono">@item.RoomNumber</div>
                    <div class="min-w-0">
                        <div class="text-slate-100 font-medium">@item.GuestName</div>
                        <div class="text-slate-500 text-sm mt-0.5">@item.Nights noches - @(Model.IsCheckIn ? $"Checkout: {item.CheckOut}" : $"Desde: {item.CheckIn}")</div>
                        <div class="text-slate-700 text-xs mt-0.5">@item.Id</div>
                    </div>
                </div>
                @if (Model.IsCheckIn)
                {
                    <form asp-action="CheckIn" method="post" class="flex-shrink-0">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="px-4 py-2 rounded-xl text-sm font-medium flex-shrink-0 transition-colors bg-emerald-600 hover:bg-emerald-500 text-white">Registrar Check-in</button>
                    </form>
                }
                else
                {
                    <a asp-action="Facturacion" asp-route-numero="@item.RoomNumber"
                       class="px-4 py-2 rounded-xl text-sm font-medium flex-shrink-0 transition-colors bg-rose-600 hover:bg-rose-500 text-white">Revisar cuenta y pagar</a>
                }
            </div>
        }
        @if (Model.Items.Count == 0)
        {
            <div class="py-12 text-center text-slate-600 text-sm">No se encontraron resultados.</div>
        }
    </div>
</div>
