@model HousekeepingPanelDto
@inject HotelSystem.Application.Reservas.PanelHousekeeping Panel
@{
    ViewData["Title"] = "Estado de Habitaciones";
    ViewData["Nav"] = "Index";
    var filters = new[] { ("all", "Todas pendientes"), ("en_limpieza", "En limpieza"), ("mantenimiento", "Mantenimiento") };
}
@* Panel en vivo: se recarga solo cuando recepcion libera una habitacion o cambia su estado. *@
<div class="p-4 sm:p-6 space-y-5 h-full overflow-y-auto" data-live-url="@Url.Action("Version", "Eventos", new { panel = "housekeeping" })" data-live-version="@Panel.Version">
    <div>
        <h1 class="text-slate-100 font-semibold text-xl">Estado de Habitaciones</h1>
        <p class="text-slate-500 text-sm mt-0.5">Actualice desde su dispositivo <span class="text-slate-700">(HU-11 - RNF-09)</span></p>
    </div>

    <div class="grid grid-cols-2 gap-3">
        <div class="bg-amber-400/8 border border-amber-500/20 rounded-xl p-4">
            <div class="text-amber-400 font-semibold text-2xl" style="@Ui.Mono">@Model.CleaningCount</div>
            <div class="text-slate-500 text-sm mt-0.5">En limpieza</div>
        </div>
        <div class="bg-slate-600/8 border border-slate-600/20 rounded-xl p-4">
            <div class="text-slate-400 font-semibold text-2xl" style="@Ui.Mono">@Model.MaintenanceCount</div>
            <div class="text-slate-500 text-sm mt-0.5">Mantenimiento</div>
        </div>
    </div>

    <div class="flex gap-2 flex-wrap">
        @foreach (var (value, label) in filters)
        {
            <a asp-action="Index" asp-route-filtro="@value"
               class="px-4 py-2 rounded-xl text-sm font-medium transition-colors @(Model.Filter == value ? "bg-amber-400/10 text-amber-400 border border-amber-400/30" : "bg-[#0e1a2e] border border-[#1a2d48] text-slate-500 hover:text-slate-300")">@label</a>
        }
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        @foreach (var room in Model.Rooms)
        {
            <div class="bg-[#0e1a2e] border rounded-2xl p-5 @Ui.Sc(room.Status).Ring">
                <div class="flex items-start justify-between mb-1">
                    <div>
                        <div class="text-slate-100 font-bold text-2xl" style="@Ui.Mono">@room.Number</div>
                        <div class="text-slate-500 text-sm">@Ui.TypeLabel(room.Type) - Piso @room.Floor</div>
                    </div>
                    @Ui.Badge(room.Status)
                </div>
                <div class="text-slate-700 text-xs mb-1">Actualizado: @room.LastUpdated</div>
                @if (room.MaintenanceNote is not null)
                {
                    <div class="text-amber-400/70 text-xs mb-3 bg-amber-400/5 border border-amber-400/10 rounded-lg px-2 py-1.5">Incidencia: @room.MaintenanceNote</div>
                }
                <form asp-action="ActualizarEstado" method="post" class="flex gap-2 mt-3">
                    <input type="hidden" name="RoomId" value="@room.Id" />
                    <input type="hidden" name="Filter" value="@Model.Filter" />
                    <button type="submit" name="NewStatus" value="@RoomStatus.Disponible" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white py-3 rounded-xl text-sm font-medium transition-colors">Marcar Disponible</button>
                    @if (room.Status == RoomStatus.EnLimpieza)
                    {
                        <a asp-action="Index" asp-route-filtro="@Model.Filter" asp-route-incidencia="@room.Id" title="Reportar incidencia (HU-11)"
                           class="px-4 py-3 bg-[#162035] hover:bg-[#1a2840] text-amber-400/70 rounded-xl text-sm transition-colors flex items-center">@Ui.Ic(Icons.Warning, 16)</a>
                    }
                    else
                    {
                        <button type="submit" name="NewStatus" value="@RoomStatus.EnLimpieza" class="px-4 py-3 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 rounded-xl text-sm transition-colors">En limpieza</button>
                    }
                </form>
            </div>
        }
        @if (Model.Rooms.Count == 0)
        {
            <div class="col-span-2 py-16 text-center">
                <div class="text-emerald-400 text-4xl mb-3">v</div>
                <div class="text-slate-400 font-medium">Sin habitaciones pendientes</div>
            </div>
        }
    </div>

    @if (Model.IncidentRoom is { } inc)
    {
        @Ui.ModalOpen($"Reportar incidencia - Hab. {inc.Number}", Url.Action("Index", new { filtro = Model.Filter })!)
        <p class="text-slate-500 text-sm mb-4">Describa el dano o problema detectado. <span class="text-slate-700">(HU-11 Esc.2)</span></p>
        <form asp-action="ReportarIncidencia" method="post" class="space-y-3">
            <input type="hidden" name="RoomId" value="@inc.Id" />
            <input type="hidden" name="Filter" value="@Model.Filter" />
            <textarea name="Note" placeholder="Ej: Grifo del bano con fuga, manija de puerta rota..." autofocus
                      class="w-full bg-[#0a1424] border border-[#1a2d48] rounded-xl px-4 py-3 text-slate-200 text-sm placeholder-slate-700 focus:outline-none focus:border-amber-400/50 resize-none h-24">@Model.IncidentNote</textarea>
            @if (Model.IncidentError is not null)
            {
                <div class="text-rose-400 text-xs bg-rose-500/10 border border-rose-500/20 rounded-xl px-3 py-2">@Model.IncidentError</div>
            }
            <div class="flex gap-2">
                <button type="submit" class="flex-1 bg-amber-500 hover:bg-amber-400 text-[#080f1c] font-semibold py-2.5 rounded-xl text-sm transition-colors">Reportar mantenimiento</button>
                <a asp-action="Index" asp-route-filtro="@Model.Filter" class="px-5 bg-[#162035] hover:bg-[#1a2840] text-slate-400 rounded-xl text-sm transition-colors flex items-center">Cancelar</a>
            </div>
        </form>
        @Ui.ModalClose()
    }
</div>
