@model IReadOnlyList<ConsumptionDto>
@{
    ViewData["Title"] = "Historial de Consumos";
    ViewData["Nav"] = "Historial";
}
<div class="p-6 space-y-5 h-full overflow-y-auto">
    <div>
        <h1 class="text-slate-100 font-semibold text-xl">Historial de Consumos</h1>
        <p class="text-slate-500 text-sm mt-0.5">@Model.Count consumos registrados</p>
    </div>
    <div class="bg-[#0e1a2e] border border-[#1a2d48] rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-[#162035]">
                    @foreach (var h in new[] { "Hab.", "Huesped", "Servicio", "Monto", "Fecha", "Hora" })
                    {
                        <th class="px-4 py-3 text-left text-xs text-slate-600 font-medium">@h</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="border-b border-[#0f1a2e] hover:bg-[#0a1424] last:border-0">
                        <td class="px-4 py-3 text-amber-400/80 font-mono">@c.RoomNumber</td>
                        <td class="px-4 py-3 text-slate-300">@c.GuestName</td>
                        <td class="px-4 py-3 text-slate-300">@c.Service</td>
                        <td class="px-4 py-3 text-slate-200 font-mono">@Ui.Money(c.Amount)</td>
                        <td class="px-4 py-3 text-slate-500">@c.Date</td>
                        <td class="px-4 py-3 text-slate-500">@c.Time</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
