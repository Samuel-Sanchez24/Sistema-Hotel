@model AdminUsersPageDto
@{
    ViewData["Title"] = "Gestion de Usuarios";
    ViewData["Nav"] = "Index";
}
<div class="p-6 space-y-5 h-full overflow-y-auto">
    <div class="flex items-start justify-between">
        <div>
            <h1 class="text-slate-100 font-semibold text-xl">Gestion de Usuarios</h1>
            <p class="text-slate-500 text-sm mt-0.5">@Model.Staff.Count usuarios - @Model.Staff.Count(u => u.Active) activos <span class="text-slate-700">(HU-01 - RN-08)</span></p>
        </div>
        <a asp-action="Index" asp-route-nuevo="@(!Model.ShowForm)" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white px-4 py-2.5 rounded-xl text-sm font-medium transition-colors">@Ui.Ic(Icons.Plus, 15)Nuevo usuario</a>
    </div>

    @if (Model.CreatedInfo is not null)
    {
        <div class="bg-emerald-500/10 border border-emerald-500/25 rounded-xl px-4 py-3 text-sm text-emerald-400 max-w-2xl">
            @Model.CreatedInfo
            <div class="text-slate-500 text-xs mt-1">Anotela ahora: no se vuelve a mostrar, porque el sistema solo guarda el hash de la contrasena.</div>
        </div>
    }

    @if (Model.ShowForm)
    {
        <form asp-action="Crear" method="post" class="bg-[#0e1a2e] border border-amber-400/20 rounded-2xl p-5 max-w-md">
            <div class="text-slate-200 font-medium mb-4">Crear cuenta <span class="text-slate-600 text-xs">(HU-01 Esc.1)</span></div>
            <div class="space-y-3">
                <input name="Name" value="@Model.Form.Name" placeholder="Nombre completo" autofocus class="w-full bg-[#0a1424] border border-[#1a2d48] rounded-xl px-4 py-2.5 text-slate-200 text-sm placeholder-slate-700 focus:outline-none focus:border-amber-400/50" />
                <input name="Email" type="email" value="@Model.Form.Email" placeholder="correo@hotel.com" class="w-full bg-[#0a1424] border border-[#1a2d48] rounded-xl px-4 py-2.5 text-slate-200 text-sm placeholder-slate-700 focus:outline-none focus:border-amber-400/50" />
                <select name="Role" class="w-full bg-[#0a1424] border border-[#1a2d48] rounded-xl px-4 py-2.5 text-slate-200 text-sm focus:outline-none focus:border-amber-400/50">
                    @foreach (var r in Model.AssignableRoles)
                    {
                        <option value="@r" selected="@(r == Model.Form.Role)">@Ui.RoleLabel(r)</option>
                    }
                </select>
                <p class="text-slate-600 text-xs">Exactamente un rol por usuario (RN-08). No se puede asignar mas de uno.</p>
                @if (Model.FormError is not null)
                {
                    <div class="text-rose-400 text-xs bg-rose-500/10 border border-rose-500/20 rounded-xl px-3 py-2">@Model.FormError</div>
                }
                <div class="flex gap-2 pt-1">
                    <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white py-2.5 rounded-xl text-sm font-medium transition-colors">Crear usuario</button>
                    <a asp-action="Index" class="px-5 bg-[#162035] hover:bg-[#1a2840] text-slate-400 rounded-xl text-sm transition-colors flex items-center">Cancelar</a>
                </div>
            </div>
        </form>
    }

    <div class="bg-[#0e1a2e] border border-[#1a2d48] rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-[#162035]">
                    @foreach (var h in new[] { "Usuario", "Email", "Rol", "Estado", "Acciones" })
                    {
                        <th class="px-5 py-3.5 text-left text-xs text-slate-600 font-medium">@h</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Staff)
                {
                    <tr class="border-b border-[#0f1a2e] last:border-0 hover:bg-[#0a1424] @(u.Active ? "" : "opacity-50")">
                        <td class="px-5 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-[#162035] flex items-center justify-center text-slate-500 text-xs font-semibold">@Ui.Initials(u.Name)</div>
                                <span class="text-slate-200 font-medium">@u.Name</span>
                            </div>
                        </td>
                        <td class="px-5 py-4 text-slate-500">@u.Email</td>
                        <td class="px-5 py-4">
                            @if (Model.EditId == u.Id)
                            {
                                <form asp-action="CambiarRol" method="post">
                                    <input type="hidden" name="UserId" value="@u.Id" />
                                    <select name="Role" data-autosubmit class="bg-[#0a1424] border border-[#1a2d48] rounded-lg px-2 py-1 text-slate-200 text-xs focus:outline-none">
                                        @foreach (var r in Model.AssignableRoles)
                                        {
                                            <option value="@r" selected="@(r == u.Role)">@Ui.RoleLabel(r)</option>
                                        }
                                    </select>
                                </form>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-editar="@u.Id" title="Modificar rol">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border @Ui.RoleColor(u.Role) hover:opacity-80">@Ui.RoleLabel(u.Role)</span>
                                </a>
                            }
                        </td>
                        <td class="px-5 py-4">
                            <span class="inline-flex items-center gap-1.5 text-xs font-medium @(u.Active ? "text-emerald-400" : "text-slate-600")">
                                <span class="w-1.5 h-1.5 rounded-full @(u.Active ? "bg-emerald-400" : "bg-slate-600")"></span>@(u.Active ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="px-5 py-4">
                            <form asp-action="ToggleActivo" method="post">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="text-xs px-3 py-1.5 rounded-lg border transition-colors @(u.Active ? "border-rose-500/20 text-rose-400 hover:bg-rose-500/10" : "border-emerald-500/20 text-emerald-400 hover:bg-emerald-500/10")">@(u.Active ? "Desactivar" : "Reactivar")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
