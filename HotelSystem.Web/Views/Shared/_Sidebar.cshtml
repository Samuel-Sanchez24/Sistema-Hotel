@{
    var role = Context.Session.GetRole() ?? Role.Huesped;
    var user = Context.Session.GetUserName();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var active = ViewData["Nav"] as string;
}
<aside class="w-56 bg-[#08111f] border-r border-[#162035] flex flex-col h-full flex-shrink-0">
    <div class="px-4 py-5 border-b border-[#162035]">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-amber-400 flex items-center justify-center flex-shrink-0">
                <span class="text-[#080f1c] font-bold text-xs" style="@Ui.Mono">FF</span>
            </div>
            <div>
                <div class="text-white font-semibold text-sm leading-tight">Fast and Furious</div>
                <div class="text-slate-600 text-xs">Gestion Hotelera</div>
            </div>
        </div>
    </div>
    <nav class="flex-1 p-2.5 space-y-0.5 overflow-y-auto">
        @foreach (var item in Navigation.For(role))
        {
            var isActive = item.Controller == controller && item.Action == active;
            <a asp-controller="@item.Controller" asp-action="@item.Action"
               class="w-full flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm transition-colors text-left @(isActive ? "bg-amber-400/10 text-amber-400 font-medium" : "text-slate-500 hover:text-slate-200 hover:bg-[#0f1e35]")">
                <span class="flex-shrink-0">@Ui.Ic(item.Icon, 15)</span>
                <span class="leading-tight">@item.Label</span>
            </a>
        }
    </nav>
    <div class="p-3 border-t border-[#162035]">
        <div class="flex items-center gap-2.5 px-2 py-2 mb-1">
            <div class="w-7 h-7 rounded-lg bg-[#162035] flex items-center justify-center text-slate-400 text-xs font-semibold flex-shrink-0">@Ui.Initials(user)</div>
            <div class="min-w-0">
                <div class="text-slate-300 text-xs font-medium truncate">@user</div>
                <div class="text-slate-600 text-xs">@Ui.RoleLabel(role)</div>
            </div>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-slate-600 hover:text-slate-400 hover:bg-[#0f1e35] text-xs transition-colors">
                @Ui.Ic(Icons.Logout, 13)
                Cerrar sesion
            </button>
        </form>
    </div>
</aside>
