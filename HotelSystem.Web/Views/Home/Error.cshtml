@model ErrorDto
@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
}
<div class="min-h-screen bg-[#080f1c] flex flex-col items-center justify-center p-6 text-center">
    <h1 class="text-rose-400 font-semibold text-2xl mb-2">Error</h1>
    <p class="text-slate-500 text-sm">Ocurrio un error al procesar la solicitud.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-slate-600 text-xs mt-2">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="mt-6 text-blue-400 text-sm hover:text-blue-300">Volver al inicio</a>
</div>
