@model GuestHomeDto
@{
    ViewData["Title"] = "Mis Reservas";
    ViewData["Nav"] = "Index";
    var actions = new[]
    {
        ("Reservar Habitacion", Icons.Calendar, "ReservarHabitacion"),
        ("Reservar Tour", Icons.Map, "ReservarTour"),
        ("Solicitar Servicio", Icons.Plus, "SolicitarServicio"),
        ("Mi Cuenta", Icons.Card, "MiCuenta"),
    };
}
<div class="p-6 space-y-6 h-full overflow-y-auto">
    <div class="bg-gradient-to-r from-[#0e1a2e] to-[#102040] border border-[#1a2d48] rounded-2xl p-6">
        <div class="text-slate-500 text-sm">Bienvenida de nuevo,</div>
        <div class="text-slate-100 font-semibold text-2xl mt-0.5">@Model.GuestName</div>
        @if (Model.Active is { } active)
        {
            <div class="mt-4 flex items-center gap-3 text-sm text-slate-400">
                <span>Hab. @active.RoomNumber - @(active.RoomType is { } rt ? Ui.TypeLabel(rt) : "")</span><span>-</span><span>@active.CheckIn a @active.CheckOut</span>
            </div>
        }
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        @foreach (var (label, icon, action) in actions)
        {
            <a asp-action="@action" class="block bg-[#0e1a2e] border border-[#1a2d48] rounded-2xl p-5 text-center hover:border-amber-400/30 hover:bg-[#102038] transition-all group">
                <div class="w-10 h-10 bg-[#162035] rounded-xl flex items-center justify-center text-amber-400/70 group-hover:text-amber-400 mx-auto mb-3 group-hover:bg-amber-400/10 transition-colors">@Ui.Ic(icon, 18)</div>
                <div class="text-slate-300 text-sm font-medium">@label</div>
            </a>
        }
    </div>

    <div>
        <div class="text-slate-400 text-sm font-medium mb-3">Mis reservas <span class="text-slate-700 text-xs">(HU-03)</span></div>
        <div class="space-y-3">
            @foreach (var res in Model.Reservations)
            {
                var cancelled = res.Status == ReservationStatus.Cancelada;
                var title = res.Kind == ReservationKind.Habitacion
                    ? $"Habitacion {res.RoomNumber ?? "(por asignar)"} - {(res.RoomType is { } t ? Ui.TypeLabel(t) : "")}"
                    : $"Tour: {res.TourName}";
                var detail = res.Kind == ReservationKind.Habitacion
                    ? $"{res.CheckIn} a {res.CheckOut} - {res.Nights} noches - {Ui.Money((res.PricePerNight ?? 0) * (res.Nights ?? 1))}"
                    : $"{res.TourDate} - {res.Persons} personas - {Ui.Money((res.TourPrice ?? 0) * (res.Persons ?? 1))}";
                <div class="bg-[#0e1a2e] border rounded-2xl p-5 transition-all @(cancelled ? "border-[#162035] opacity-60" : "border-[#1a2d48]")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="text-slate-100 font-medium">@title</span>
                                @Ui.Pill(Ui.ReservationStatusColor(res.Status), Ui.StatusLabel(res.Status))
                                @if (res.Cancellable && res.LateCancel && !cancelled)
                                {
                                    @Ui.Pill("bg-amber-500/10 text-amber-400 border-amber-500/20", "Cargo si cancela")
                                }
                            </div>
                            <div class="text-slate-500 text-sm mt-1">@detail</div>
                            <div class="text-slate-700 text-xs mt-0.5">@res.Id</div>
                        </div>
                        @if (!cancelled)
                        {
                            <a asp-action="Index" asp-route-cancelar="@res.Id"
                               class="flex-shrink-0 px-3 py-1.5 text-xs rounded-xl border transition-colors @(res.Cancellable ? "border-rose-500/25 text-rose-400 hover:bg-rose-500/10" : "border-slate-700 text-slate-700 cursor-not-allowed")">Cancelar</a>
                        }
                    </div>
                    @if (res.Status == ReservationStatus.EnCurso)
                    {
                        <div class="mt-3 inline-flex items-center gap-1.5 text-xs text-emerald-400"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>Check-in realizado</div>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.CancelTarget is { } target)
    {
        @Ui.ModalOpen("Cancelar reserva", Url.Action("Index")!)
        @if (target.Cancellable)
        {
            <div class="rounded-xl px-4 py-3 mb-4 text-sm @(target.LateCancel ? "bg-rose-500/10 border border-rose-500/20 text-rose-300" : "bg-emerald-500/10 border border-emerald-500/20 text-emerald-300")">
                @if (target.LateCancel)
                {
                    @($"Cancelacion tardia. Cargo de 1 noche: {Ui.Money(target.PricePerNight ?? target.TourPrice ?? 0)} (RN-09 - HU-03 Esc.6)")
                }
                else
                {
                    @("Cancelacion gratuita. Mas de 48h antes del check-in. (RN-09 - HU-03 Esc.5)")
                }
            </div>
            <form asp-action="Cancelar" method="post" class="flex gap-2">
                <input type="hidden" name="id" value="@target.Id" />
                <button type="submit" class="flex-1 py-2.5 rounded-xl text-sm font-medium text-white @(target.LateCancel ? "bg-rose-600 hover:bg-rose-500" : "bg-emerald-600 hover:bg-emerald-500") transition-colors">Confirmar cancelacion</button>
                <a asp-action="Index" class="px-5 bg-[#162035] hover:bg-[#1a2840] text-slate-400 rounded-xl text-sm transition-colors flex items-center">No cancelar</a>
            </form>
        }
        else
        {
            <div class="bg-slate-600/10 border border-slate-600/20 rounded-xl px-4 py-3 mb-4 text-sm text-slate-400">
                <div class="font-medium text-slate-300 mb-1">No es posible cancelar</div>
                @target.CancelReason
            </div>
            <a asp-action="Index" class="block text-center w-full py-2.5 bg-[#162035] hover:bg-[#1a2840] text-slate-300 rounded-xl text-sm transition-colors">Cerrar</a>
        }
        @Ui.ModalClose()
    }
</div>
