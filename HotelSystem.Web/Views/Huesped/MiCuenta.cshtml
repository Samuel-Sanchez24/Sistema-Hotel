@model GuestBillDto
@{
    ViewData["Title"] = "Mi Cuenta";
    ViewData["Nav"] = "MiCuenta";
}
<div class="p-6 space-y-5 h-full overflow-y-auto">
    <div>
        <h1 class="text-slate-100 font-semibold text-xl">Mi Cuenta</h1>
        <p class="text-slate-500 text-sm mt-0.5">Resumen de prefactura - Hab. @Model.RoomNumber <span class="text-slate-700">(HU-12 - RN-07)</span></p>
    </div>
    <div class="max-w-md">
        <div class="bg-[#0e1a2e] border border-[#1a2d48] rounded-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-[#162035]">
                <div class="text-slate-100 font-semibold">@Model.GuestName</div>
                <div class="text-slate-500 text-sm">Hab. @Model.RoomNumber - @Model.Stay</div>
                <div class="mt-2">@Ui.Pill("bg-blue-500/10 text-blue-400 border-blue-500/20", "Prefactura")</div>
            </div>
            <div class="px-6 py-4 space-y-3">
                <div class="flex justify-between items-start">
                    <div>
                        <div class="text-slate-200 text-sm font-medium">Alojamiento</div>
                        <div class="text-slate-500 text-xs">@Model.Nights noches x @Ui.Money(Model.PricePerNight)</div>
                    </div>
                    <span class="text-slate-200 text-sm" style="@Ui.Mono">@Ui.Money(Model.RoomTotal)</span>
                </div>
                @if (Model.Consumptions.Count > 0)
                {
                    <div class="pt-3 border-t border-[#162035]">
                        <div class="text-slate-500 text-xs font-medium mb-2">Servicios adicionales</div>
                        @foreach (var c in Model.Consumptions)
                        {
                            <div class="flex justify-between py-1.5">
                                <span class="text-slate-400 text-sm">@c.Service</span>
                                <span class="text-slate-300 text-sm" style="@Ui.Mono">@Ui.Money(c.Amount)</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pt-2 border-t border-[#162035] text-slate-600 text-sm">Servicios adicionales: @Ui.Money(0) <span class="text-slate-700">(HU-12 Esc.2)</span></div>
                }
                <div class="pt-4 border-t border-[#253d60] flex justify-between items-center">
                    <span class="text-slate-100 font-semibold">Total estimado</span>
                    <span class="text-amber-400 font-semibold text-xl" style="@Ui.Mono">@Ui.Money(Model.Total)</span>
                </div>
            </div>
        </div>
        <p class="text-slate-600 text-xs mt-3 text-center">Solo resumen de prefactura. La cuenta se cierra al check-out (RN-07).</p>
        <a asp-action="MiCuenta" asp-route-factura="true" class="block text-center mt-3 w-full border border-slate-700 text-slate-500 hover:text-slate-300 hover:border-slate-600 py-2.5 rounded-xl text-sm transition-colors">
            Solicitar factura formal
        </a>
    </div>

    @if (Model.ShowInvoiceModal)
    {
        @Ui.ModalOpen("Factura formal", Url.Action("MiCuenta")!)
        <div class="bg-amber-400/8 border border-amber-400/15 rounded-xl px-4 py-4 mb-4 text-sm text-amber-300">
            <div class="font-medium mb-1">Solo se ofrece prefactura <span class="text-amber-600">(HU-12 Esc.5)</span></div>
            El sistema proporciona unicamente un resumen de prefactura. La emision de comprobantes fiscales, calculo de impuestos y pago en linea se gestiona fuera del sistema hotelero.
        </div>
        <a asp-action="MiCuenta" class="block text-center w-full py-2.5 bg-[#162035] hover:bg-[#1a2840] text-slate-300 rounded-xl text-sm transition-colors">Entendido</a>
        @Ui.ModalClose()
    }
</div>
