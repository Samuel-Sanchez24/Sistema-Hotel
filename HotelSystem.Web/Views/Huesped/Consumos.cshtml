@model GuestConsumptionsDto
@{
    ViewData["Title"] = "Mis Consumos";
    ViewData["Nav"] = "Consumos";
}
<div class="p-6 space-y-5 h-full overflow-y-auto">
    <div>
        <h1 class="text-slate-100 font-semibold text-xl">Mis Consumos</h1>
        <p class="text-slate-500 text-sm mt-0.5">Hab. @Model.RoomNumber <span class="text-slate-700">(HU-07 - RN-07)</span></p>
    </div>
    @if (Model.Items.Count > 0)
    {
        <div class="space-y-2 max-w-lg">
            @foreach (var c in Model.Items)
            {
                <div class="bg-[#0e1a2e] border border-[#1a2d48] rounded-xl px-5 py-4 flex justify-between items-center">
                    <div>
                        <div class="text-slate-200 font-medium text-sm">@c.Service</div>
                        <div class="text-slate-600 text-xs mt-0.5">@c.Date - @c.Time</div>
                    </div>
                    <span class="text-slate-200 text-sm font-medium" style="@Ui.Mono">@Ui.Money(c.Amount)</span>
                </div>
            }
            <div class="bg-[#0e1a2e] border border-amber-400/15 rounded-xl px-5 py-4 flex justify-between items-center">
                <span class="text-slate-300 font-semibold">Total servicios</span>
                <span class="text-amber-400 font-semibold" style="@Ui.Mono">@Ui.Money(Model.Total)</span>
            </div>
        </div>
    }
    else
    {
        <div class="py-16 text-center text-slate-600 text-sm"><div class="text-3xl mb-3 opacity-40">-</div>Sin consumos registrados aun. <span class="text-slate-700">(HU-07 Esc.4)</span></div>
    }
</div>
