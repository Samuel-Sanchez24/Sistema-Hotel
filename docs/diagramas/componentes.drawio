        <mxCell id="c28" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=20;fillColor=#FFF7C2;strokeColor=#D4B93C;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontSize=14;fontColor=#14283B;" value="&lt;b&gt;Trazabilidad con el C4 nivel 1 (Entregable 1)&lt;/b&gt;&lt;br&gt;• 6 roles: Huésped, Recepción, Coordinador de tours, Housekeeping,&lt;br&gt;Personal de servicios y Administrador.&lt;br&gt;• Externos: servicio de correo (RF-02); pasarela de pagos (pendiente)." vertex="1">
