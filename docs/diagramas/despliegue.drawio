        <mxCell id="n71" edge="1" parent="1" source="n32" style="endArrow=oval;startArrow=oval;endFill=0;startFill=0;endSize=8;startSize=8;html=1;strokeColor=#1E2050;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontColor=#1E2050;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="n42" value="TCP · SQL Server TDS (1433)&lt;br&gt;EF Core · HotelSystem.API">
