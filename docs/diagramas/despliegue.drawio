        <mxCell id="n73" edge="1" parent="1" source="n32" style="endArrow=oval;startArrow=oval;endFill=0;startFill=0;endSize=8;startSize=8;html=1;strokeColor=#1E2050;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;fontColor=#1E2050;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#7A7A7A;exitX=0.74;exitY=0;entryX=0.5;entryY=1;" target="n51" value="HTTPS (443)&lt;br&gt;[pendiente]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n74" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FAFAFF;strokeColor=#5B5FC7;fontColor=#1E2050;fontSize=11;fontFamily=Courier New;" value="&lt;b&gt;«deployment spec»&lt;br&gt;web.config — Servidor Web&lt;/b&gt;&lt;br&gt;&lt;br&gt;SO = Windows Server 2022&lt;br&gt;Hosting = IIS 10 + Hosting Bundle .NET 10&lt;br&gt;Puerto = 443 HTTPS (TLS 1.2+)&lt;br&gt;&amp;nbsp;&amp;nbsp;80 → redirección a 443&lt;br&gt;ASPNETCORE_ENVIRONMENT = Production&lt;br&gt;Cadena de conexión = SQL Server srv-bd:1433&lt;br&gt;&amp;nbsp;&amp;nbsp;(misma base que la API)&lt;br&gt;Recursos = 4 vCPU · 8 GB RAM (supuesto)" vertex="1">
          <mxGeometry height="200" width="420" x="980" y="760" as="geometry" />
        </mxCell>
        <mxCell id="n75" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FAFAFF;strokeColor=#5B5FC7;fontColor=#1E2050;fontSize=11;fontFamily=Courier New;" value="&lt;b&gt;«deployment spec»&lt;br&gt;appsettings — API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Puerto = 443 HTTPS&lt;br&gt;Autenticación = JWT Bearer&lt;br&gt;BaseDeDatos.Proveedor = SqlServer&lt;br&gt;Correo.Modo = Smtp (587)&lt;br&gt;Jwt.Clave = secreto fuera del código&lt;br&gt;Hotel.HoraCheckIn = 15:00&lt;br&gt;Recursos = 4 vCPU · 8 GB RAM&lt;br&gt;&amp;nbsp;&amp;nbsp;(supuesto)" vertex="1">
          <mxGeometry height="220" width="290" x="2140" y="720" as="geometry" />
        </mxCell>
        <mxCell id="n76" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FAFAFF;strokeColor=#5B5FC7;fontColor=#1E2050;fontSize=11;fontFamily=Courier New;" value="&lt;b&gt;«deployment spec»&lt;br&gt;Servidor de Base de Datos&lt;/b&gt;&lt;br&gt;&lt;br&gt;SGBD = SQL Server 2022&lt;br&gt;Puerto = 1433 (solo red interna)&lt;br&gt;Cifrado = TDE AES‑256&lt;br&gt;&amp;nbsp;&amp;nbsp;(propuesto)&lt;br&gt;Reservas = serializable&lt;br&gt;&amp;nbsp;&amp;nbsp;(implementado)&lt;br&gt;Respaldo = diario (propuesto)&lt;br&gt;Recursos = 4 vCPU · 16 GB RAM&lt;br&gt;&amp;nbsp;&amp;nbsp;(supuesto)" vertex="1">
          <mxGeometry height="245" width="290" x="2140" y="960" as="geometry" />
        </mxCell>
        <mxCell id="n77" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FAFAFF;strokeColor=#5B5FC7;fontColor=#1E2050;fontSize=11;fillColor=#FFF8E6;strokeColor=#D99A00;" value="&lt;b&gt;Nota — Web y API en el código&lt;/b&gt;&lt;br&gt;HotelSystem.Web (ASP.NET Core MVC) implementa el Portal del Huésped y el Panel Interno del C4 Nivel 2 y usa la capa de aplicación en el mismo proceso; por eso se conecta directamente a la base de datos. HotelSystem.API expone los mismos servicios por REST/JWT para clientes externos (front HTML/JS)." vertex="1">
          <mxGeometry height="110" width="420" x="980" y="985" as="geometry" />
        </mxCell>
        <mxCell id="n78" edge="1" parent="1" source="n74" style="endArrow=none;dashed=1;html=1;strokeColor=#5B5FC7;startArrow=oval;startFill=0;startSize=6;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" target="n22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n79" edge="1" parent="1" source="n75" style="endArrow=none;dashed=1;html=1;strokeColor=#5B5FC7;startArrow=oval;startFill=0;startSize=6;exitX=0;exitY=0.3;entryX=1;entryY=0.03;" target="n32" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n80" edge="1" parent="1" source="n76" style="endArrow=none;dashed=1;html=1;strokeColor=#5B5FC7;startArrow=oval;startFill=0;startSize=6;exitX=0;exitY=0.4;entryX=0.8;entryY=0;" target="n42" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n81" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#B9BEE0;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#3B2A8F;margin-bottom:6px;&#39;&gt;Atributos de calidad (RNF) → decisión en el despliegue&lt;/div&gt;&lt;table style=&#39;width:1660px;border-collapse:collapse;font-size:12.5px;color:#1E2050;&#39;&gt;&lt;tr style=&#39;background:#3B3F8F;color:#FFFFFF;&#39;&gt;&lt;th style=&#39;padding:4px 8px;text-align:left;&#39;&gt;RNF&lt;/th&gt;&lt;th style=&#39;padding:4px 8px;text-align:left;&#39;&gt;Atributo&lt;/th&gt;&lt;th style=&#39;padding:4px 8px;text-align:left;&#39;&gt;Estado&lt;/th&gt;&lt;th style=&#39;padding:4px 8px;text-align:left;&#39;&gt;Decisión en el despliegue&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑01&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Rendimiento&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#B45309;font-weight:bold;&#39;&gt;Propuesto&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;La API corre en un servidor dedicado, separado de la web y de la BD; la comunicación interna va por la LAN del hotel (baja latencia).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑02&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Seguridad&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#5B3FC4;font-weight:bold;&#39;&gt;Mixto&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;Implementado:&lt;/b&gt; HTTPS (redirección en Web y API), JWT en la API, contraseñas con PBKDF2. &lt;b&gt;Propuesto:&lt;/b&gt; firewall perimetral, BD solo en red interna, cifrado TDE AES‑256.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑03&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Disponibilidad&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#B45309;font-weight:bold;&#39;&gt;Propuesto&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Respaldos diarios (respaldo.bak), servidores con UPS y ventanas de mantenimiento programadas fuera de horas pico.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑04&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Usabilidad&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#11795A;font-weight:bold;&#39;&gt;Implementado&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Reserva de habitación en 3 pasos (Preferencias → Elegir habitación → Confirmar), servida desde el Servidor Web; el huésped no instala nada.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑05&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Compatibilidad&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#11795A;font-weight:bold;&#39;&gt;Implementado&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Aplicación web: el nodo cliente solo necesita Chrome, Edge o Safari (dos últimas versiones estables).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑06&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Escalabilidad&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#B45309;font-weight:bold;&#39;&gt;Propuesto&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Capas en nodos separados: se pueden ampliar recursos o agregar otra instancia de la API sin tocar la BD (60 habitaciones, 20 tours/día).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑07&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Consistencia&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#11795A;font-weight:bold;&#39;&gt;Implementado&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Una sola base de datos central; las reservas de habitación y cupos de tour usan transacción serializable (con prueba de concurrencia).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑08&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Mantenibilidad&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#5B3FC4;font-weight:bold;&#39;&gt;Mixto&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;Implementado:&lt;/b&gt; cada capa es un .dll independiente y hay 59 pruebas xUnit. &lt;b&gt;Propuesto:&lt;/b&gt; medir la cobertura (&amp;gt;70 %) y correr las pruebas antes de cada despliegue.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑09&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Portabilidad&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#5B3FC4;font-weight:bold;&#39;&gt;Mixto&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;Implementado:&lt;/b&gt; Panel Interno web y responsive (Tailwind CSS). &lt;b&gt;Propuesto:&lt;/b&gt; acceso desde tablet o smartphone por el Wi‑Fi interno del hotel.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;RNF‑10&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;Legalidad&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;span style=&#39;color:#5B3FC4;font-weight:bold;&#39;&gt;Mixto&lt;/span&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px 8px;border-bottom:1px solid #D5D8EE;&#39;&gt;&lt;b&gt;Implementado:&lt;/b&gt; acceso por roles y contraseñas cifradas. &lt;b&gt;Propuesto:&lt;/b&gt; datos personales solo en servidores del hotel y cifrados en reposo (Ley 1581 de 2012).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&#39;font-size:11px;color:#555;margin-top:8px;&#39;&gt;&lt;b&gt;Supuestos de diseño:&lt;/b&gt; la versión del SO y de SQL Server y los recursos (vCPU, RAM) no salen del código; son la propuesta de infraestructura para el hotel.&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="1690" x="20" y="1250" as="geometry" />
